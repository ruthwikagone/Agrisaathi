# Raw datasets and trained artifacts that are deliberately not versioned
datasets/crop/raw/
datasets/crop/processed/
datasets/plantvillage/source/
datasets/plantvillage/processed/

models/crop/*.joblib
models/crop/*.json
models/plant_disease/*.keras
models/plant_disease/*.json

reports/crop/*.json
reports/plant_disease/*.json

# Large plant disease datasets
five_crop_diseases/
plantdoc/

# Keep directory layout in git without committing data
!datasets/**/.gitkeep
!models/**/.gitkeep
!reports/**/.gitkeep