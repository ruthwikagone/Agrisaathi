# Copy to .env or an environment-specific secret store. Do not commit real values.
# Values below are placeholders and do not enable external services by themselves.

# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Same-origin application storage. Use persistent, access-restricted absolute
# paths in production; do not place either location under the frontend root.
# Relative paths are resolved from the repository root.
DATABASE_PATH=./backend/data/agrisaathi.db
UPLOADS_DIR=./backend/uploads

# Request and upload validation
MAX_JSON_BYTES=12582912
MAX_IMAGE_BYTES=8388608

# Optional API bearer token. Leave blank for the local single-user mode. If set,
# clients must send it in Authorization: Bearer <token>.
API_TOKEN=

# Weather: Open-Meteo is the planned default and normally requires no key.
# Leave API keys blank unless switching to a provider that requires one.
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=
WEATHER_TIMEOUT_MS=10000

# Local Python ML scripts/artifacts. No standalone ML HTTP service is assumed.
PYTHON_BIN=python

# Copilot uses local intent routing and does not require an AI API key.
SEED_CATALOG_URL=http://127.0.0.1:3000/api/seed/catalog

# Browser notifications require user permission; this value must not bypass it.
WEATHER_ALERTS_ENABLED=false
