# ==========================================
# SECRETS AND LOCAL ENVIRONMENT
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key


# ==========================================
# NODE.JS
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log


# ==========================================
# RUNTIME DATA / DATABASE / UPLOADS
# ==========================================
data/*.sqlite
data/*.sqlite-*
data/*.db
data/*.db-*
data/uploads/
data/tmp/

uploads/

backend/data/*.sqlite
backend/data/*.sqlite-*
backend/data/*.db
backend/data/*.db-*
backend/uploads/


# ==========================================
# PYTHON ENVIRONMENTS
# ==========================================
.venv/
venv/
ml/.venv/

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ==========================================
# DATASETS
# ==========================================
ml/datasets/**
!ml/datasets/.gitkeep


# ==========================================
# ML MODELS
# ==========================================

# Ignore model folders by default
ml/models/*
!ml/models/.gitkeep

# Allow Plant Disease model folder
!ml/models/plant_disease/

# Allow Plant Disease Keras models
!ml/models/plant_disease/*.keras

# Allow Plant Disease JSON files
!ml/models/plant_disease/*.json


# ==========================================
# OTHER ML ARTIFACTS
# ==========================================
ml/reports/**
!ml/reports/.gitkeep

*.joblib
*.h5
*.onnx
*.pt
*.pth
*.tflite


# ==========================================
# BUILD / CACHE
# ==========================================
dist/
build/
coverage/
.cache/


# ==========================================
# OS / EDITOR
# ==========================================
.DS_Store
Thumbs.db

.vscode/
.idea/


# ==========================================
# LARGE DATASETS
# ==========================================
ml/plantdoc/
ml/five_crop_diseases/


# ==========================================
# FRONTEND BACKUP FILES
# ==========================================
frontend/*.backup
